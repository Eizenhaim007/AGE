---
import Brand from './Brand.astro';
import Icon from './Icon.astro';
import { content } from '../content/site';

const { locale, home = false } = Astro.props;
const copy = content[locale];
const otherLocale = locale === 'fr' ? 'en' : 'fr';
const link = (section) => `${home ? '' : copy.path}#${section}`;
const links = ['services', 'projects', 'about'];
---
<header class="site-header" data-site-header>
  <div class="wrap header-row">
    <Brand locale={locale} />
    <div class="header-controls">
      <a class="language-link" href={copy.alternatePath} hreflang={otherLocale} lang={otherLocale} aria-label={copy.alternateName}>
        {otherLocale.toUpperCase()}
      </a>
      <button type="button" class="menu-toggle" aria-label={copy.menu} aria-expanded="false" aria-controls="site-nav">
        <span class="menu-open" aria-hidden="true"><Icon name="menu" /></span>
        <span class="menu-close" aria-hidden="true"><Icon name="close" /></span>
      </button>
    </div>
    <nav id="site-nav" class="site-nav" aria-label={copy.navLabel}>
      {copy.nav.map((item, index) => <a href={link(links[index])}>{item}</a>)}
      <a class="button" href={link('contact')}>{copy.contactLabel}</a>
    </nav>
  </div>
</header>
<script>
  const header = document.querySelector<HTMLElement>('[data-site-header]');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const navigation = header?.querySelector<HTMLElement>('.site-nav');

  if (header && toggle && navigation) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      navigation.classList.toggle('is-open', open);
    };

    header.dataset.enhanced = '';
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') === 'false'));
    header.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    navigation.addEventListener('click', (event) => {
      if (!(event.target instanceof Element) || toggle.getAttribute('aria-expanded') !== 'true') return;
      const anchor = event.target.closest('a');
      if (!anchor) return;
      setOpen(false);
      if (!anchor.getAttribute('href')?.startsWith('#')) return;
      const target = document.getElementById(anchor.hash.slice(1));
      target?.focus({ preventScroll: true });
    });
  }
</script>
